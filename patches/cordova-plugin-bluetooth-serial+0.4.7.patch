+    // Fix: ver nota junto a UNPAIR más arriba. BluetoothDevice.removeBond() no
+    // es parte del API público de Android (está marcado @hide desde siempre),
+    // así que la única forma de invocarlo desde una app normal es por
+    // reflexión. Es una técnica ampliamente usada y estable en la práctica:
+    // el método existe en todas las versiones de Android desde la 2.x y su
+    // firma no ha cambiado nunca.
+    private void unpairDevice(CordovaArgs args, CallbackContext callbackContext) throws JSONException {
+        String macAddress = args.getString(0);
+        BluetoothDevice device = bluetoothAdapter.getRemoteDevice(macAddress);
+
+        if (device == null) {
+            callbackContext.error("Dispositivo no encontrado: " + macAddress);
+            return;
+        }
+
+        try {
+            java.lang.reflect.Method removeBondMethod = device.getClass().getMethod("removeBond");
+            Object result = removeBondMethod.invoke(device);
+            if (Boolean.TRUE.equals(result)) {
+                callbackContext.success();
+            } else {
+                callbackContext.error("removeBond() devolvió false para " + macAddress);
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "No se pudo eliminar el emparejamiento de " + macAddress, e);
+            callbackContext.error("No se pudo eliminar el emparejamiento: " + e.getMessage());
+        }
+    }
+
