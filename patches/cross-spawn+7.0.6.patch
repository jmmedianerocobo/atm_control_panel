diff --git a/node_modules/cross-spawn/lib/parse.js b/node_modules/cross-spawn/lib/parse.js
index 0129d74..78c3e47 100644
--- a/node_modules/cross-spawn/lib/parse.js
+++ b/node_modules/cross-spawn/lib/parse.js
@@ -46,7 +46,18 @@ function parseNonShell(parsed) {
 
         // Normalize posix paths into OS compatible paths (e.g.: foo/bar -> foo\bar)
         // This is necessary otherwise it will always fail with ENOENT in those cases
-        parsed.command = path.normalize(parsed.command);
+        //
+        // patch-package fix: prefer the already-resolved `commandFile` (absolute,
+        // with the real extension, e.g. "...\gradlew.BAT") over the raw
+        // `parsed.command`. path.normalize() on win32 collapses a relative
+        // "./gradlew" down to the bare word "gradlew" (no separator), which then
+        // gets shelled out as `cmd.exe /d /s /c "gradlew ..."`. cmd.exe's
+        // one-shot /c dispatch does NOT search the current directory for a bare
+        // command name (unlike an interactive prompt or an explicit ".\gradlew"),
+        // so this always failed with "'gradlew' is not recognized..." even
+        // though gradlew.bat exists right there — see cross-spawn upstream bug,
+        // reproduced against gradlew on Windows.
+        parsed.command = path.normalize(commandFile || parsed.command);
 
         // Escape command & arguments
         parsed.command = escape.command(parsed.command);
